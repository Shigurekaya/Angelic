{
  "source": "option.tjs + uioption.tjs + pbd2json + settings_truth.json",
  "status": "working",
  "notes": [
    "This is the local semantic mapping for settings-page reconstruction.",
    "It intentionally separates original module semantics from current RenPy rendering layers.",
    "Page count in original OptionPageModule is 10, but current reconstruction is temporarily collapsed to 6 visible pages in the UI preview/runtime.",
    "The `simple` page uses slots a-j in the original model; `skipall` and `movie` are routed to deeper/detail or later-page behavior in current reconstruction.",
    "Angelic layout truth is not Cafe absolute coordinates; use settings_truth.json as the current geometry guide and option.tjs/uioption.tjs for behavior semantics."
  ],
  "pages": {
    "01basic": {
      "visible_in_current_ui": true,
      "role": "basic/simple settings page",
      "module": "OptionStandardModule + CustomOption",
      "slots": [
        {"slot": "a", "key": "fullscreen", "type": "toggle", "label_id": "label_a", "jump": "label_a_jump", "detail_page": 1},
        {"slot": "b", "key": "sqscr", "type": "toggle", "label_id": "label_b", "jump": "label_b_jump", "detail_page": 1},
        {"slot": "c", "key": "textspeed", "type": "slider", "label_id": "label_c", "jump": "label_c_jump", "detail_page": 4},
        {"slot": "d", "key": "autospeed", "type": "slider", "label_id": "label_d", "jump": "label_d_jump", "detail_page": 4},
        {"slot": "e", "key": "skipall", "type": "toggle", "label_id": "label_e", "jump": "label_e_jump", "detail_page": 4},
        {"slot": "f", "key": "wave", "type": "slider", "label_id": "label_f", "jump": "label_f_jump", "detail_page": "06sound"},
        {"slot": "g", "key": "bgm", "type": "slider", "label_id": "label_g", "jump": "label_g_jump", "detail_page": "06sound"},
        {"slot": "h", "key": "se", "type": "slider", "label_id": "label_h", "jump": "label_h_jump", "detail_page": "06sound"},
        {"slot": "i", "key": "voice", "type": "slider", "label_id": "label_i", "jump": "label_i_jump", "detail_page": "06sound"},
