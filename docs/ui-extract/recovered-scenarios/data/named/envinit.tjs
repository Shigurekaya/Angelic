%[
	"excommands", %[
		"sysvoice", 0,
		"beforemovie", COMMAND_SYNC,
		"break", COMMAND_SYNC,
		"suspendsave", COMMAND_SAVE,
		],

	// シーン区切りになるラベル
	"sceneLabel", /^\*chapter|:/,

	//"showExtend", [800,50,800,50], // 立ち絵カット処理時にその状態をトリミング表示
	//"checkExtend", true, // 立ち絵カット処理時にはみで表示が見えていると警告を出す
	
	// コンバート時に条件に応じて画像多重化処理を行う対応
	//"imageConvertConditions",  [
	//	// sf:dressnamemap 処理用の変数定義 eval:実行時での判定式 conveval:条件登録するかどうかの判定
	//	%[sf:%[dlc:1],eval:"checkDLC(1)",conveval:'imageConvertOptions.target=="VITA"'], // VITA用
	//	%[sf:%[dlc:2],eval:"checkDLC(2)",conveval:'imageConvertOptions.target=="VITA"'], // VITA用
	//	],

	// レイヤ系スケーリング指定
	// スクリプトでの座標値と実画面での座標値のスケーリング処理を行う
	//"scalex", 1.6,    X方向のスケール(default:1.0)
	//"scaley", 1.6,    Y方向のスケール(default:1.0)
	//"width" , 800,    仮想画面サイズ横幅(default:scWidth/scalex)
	//"height", 600,    仮想画面サイズ縦幅(default:scHeight/scaley)

	// スケール補正対応
//	"envWidth", 1280,
//	"envHeight", 720,

	// 舞台情報定義
	// 基準になる stage ファイルを指定する
	"stageInfo" => "base.stage",
	
	// stage/stime/アクションを直接コマンドとして使った場合の
	// デフォルトターゲットを変更
	// ※未指定時は環境に対して処理される
	"defaultTarget" => "stage",

	// posのカンマ指定の3つ目のパラメータをzorderにする
	//"posInfoZorder" => true,
	
	// ------------------------------------------------------------------
	// レイヤ配置情報定義
	// disp
	// xpos
	// ypos
	// zpos
	// reset
	// front
	// back

	// レイヤ配置情報定義
	// disp
	// xpos
	// ypos
	// zpos
	// reset
	// front
	// back

	// ------------------------------------------------------------------

	// autoface.tjs 設定
	"autoFaceShow",  true,  // 顔窓自動表示	 false :無効							[true]:有効(話者にあわせて表示制御する)
//	"syncFaceShow",  true,  // face同期表示	 false :顔位置オブジェクトのみ対象		[true]:立ち絵に同期した顔窓表示を追加する
	"eventFaceShow", true, // イベント時	[false]:イベント絵時は自動表示しない	 true :イベント絵時も自動表示する
//	"forceFaceShow", false, // 強制表示		[false]:顔窓を立ち絵の表示状態に合わせる true :立ち絵が消えていても表示する
//	"autoFaceHide",  true,  // 顔窓自動消去  false :無効							[true]:有効(地の文やコマンド演出時に消去する)
	"facePosMode", 0, // 座標を実行時に補正

	// レベル番号とzorderの対応を記載する
	"levels" => [ 35,50,65,75,85,90,100,120 ], 
	
	"positions" => %[
		// ※type定義は不要になりました。disp/xpos/ypos/level いずれかの定義が記述されていればそれが使用されます。

		// 表示定義（顔表示は，フェイスウィンドウ機能がない場合には意味を持ちません）
		"出" => %[ "disp" => KAGEnvImage.SHOW  ,"className" => "" ], // 表示
		"立" => %[ "disp" => KAGEnvImage.SHOW  ,"className" => "bu"     ], // 表示
		"消" => %[ "disp" => KAGEnvImage.CLEAR     ], // 一時非表示（状態変更による自動表示は有効）※基本はこちらを使います
		"無" => %[ "disp" => KAGEnvImage.INVISIBLE ], // 完全非表示（状態変更による自動表示も無効）

		"顔" => %[ "disp" => KAGEnvImage.SHOW, "className", "msgwin" ], // 顔配置用クラス指定
		"両" => %[ "disp" => KAGEnvImage.SHOW, "className", "" ], // 標準に戻す(立ち絵と顔両方)クラス指定
		
		// 位置定義
		"中"   => %[ "xpos" => int    0 ],
		"左接" => %[ "xpos" => int -240 ],
		"右接" => %[ "xpos" => int  240 ],
		"左近"   => %[ "xpos" => int -360 ],
		"右近"   => %[ "xpos" => int  360 ],
		"左中" => %[ "xpos" => int -480 ],
		"右中" => %[ "xpos" => int  480 ],
		"左" => %[ "xpos" => int -600 ],
		"右" => %[ "xpos" => int  600 ],
		"左奥" => %[ "xpos" => int -720 ],
		"右奥" => %[ "xpos" => int  720 ],
		"左外" => %[ "xpos" => int -840 ],
		"右外" => %[ "xpos" => int  840 ],
		"左大外" => %[ "xpos" => int -960 ],
		"右大外" => %[ "xpos" => int  960 ],
		"左枠外" => %[ "xpos" => int -1080 ],
		"右枠外" => %[ "xpos" => int  1080 ],

		// yposは直で個別に指定する場合が多いようです
		"真中" => %[ "ypos" => int    0 ],
		"アップ"   => %[ "ypos" => int   25 ],
//		"縦背伸"     => %[ "ypos" => int  -20 ],

		"仮100" => %[ "ypos" => int    -100 ],
		"仮200" => %[ "ypos" => int    -200 ],
		"仮250" => %[ "ypos" => int    -250 ],
		"仮300" => %[ "ypos" => int    -300 ],

		// レベル指定 + リセット処理
		// ※zpos指定は純粋な座標指定に仕様変更になりました。
		// ズーム値での指定は zorder が使えます
		"50%"   => %[ zorder: int 50, ypos:0, resetpos:true, front:true, className:"" ],
		"60%"   => %[ zorder: int 60, ypos:0, resetpos:true, front:true, className:"" ],
		"65%"   => %[ zorder: int 65, ypos:0, resetpos:true, front:true, className:"" ],
		"70%"   => %[ zorder: int 70, ypos:0, resetpos:true, front:true, className:"" ],
		"75%"   => %[ zorder: int 75, ypos:0, resetpos:true, front:true, className:"" ],
		"80%"   => %[ zorder: int 80, ypos:0, resetpos:true, front:true, className:"" ],
		"85%"   => %[ zorder: int 85, ypos:0, resetpos:true, front:true, className:"" ],
		"90%"   => %[ zorder: int 90, ypos:0, resetpos:true, front:true, className:"" ],
		"100%"  => %[ zorder: int 100,ypos:0, resetpos:true, front:true, className:"" ],
		"110%"  => %[ zorder: int 110,ypos:0, resetpos:true, front:true, className:"" ],
		"120%"  => %[ zorder: int 120,ypos:0, resetpos:true, front:true, className:"" ],


		],

	// 自動レイアウト指定
	"layouts" => %[
		"入場" => %[ "type", "normal", "pos", "right", "trans", "showslide" ],
		"割込" => %[ "type", "normal", "pos", "center", "trans", "showslide" ],
		"退場" => %[ "type", "normal", "pos", "hide", "trans", "showslide" ],
		// 入退場定義・サイズ補正あり
		"入場2" => %[ "type", "autolevel", "pos", "right", "reload", true, "trans", "showslide" ],
		"退場2" => %[ "type", "autolevel", "pos", "hide", "reload", true, "trans", "showslide" ],
	],

	// レイアウト用座標定義・レベルあり
	"layouts_autolevel" => [
		%[ "xpos", [0], "level", 2, "leveltrans", "showslide", "time", 300 ],
		%[ "xpos", [-250,250], "level", 1, "leveltrans", "showslide", "time", 300 ],
		%[ "xpos", [-400,0,400], "level", 1, "leveltrans", "showslide", "time", 300 ],
		%[ "xpos", [-500,-200,200,500], "level", 1, "leveltrans", "showslide", "time", 300 ],
	],
	// レイアウト用座標定義・レベル無し
	"layouts_normal" => [
		%[ "xpos", [0], "time", 300],
		%[ "xpos", [-250,250], "time", 300 ],
		%[ "xpos", [-400,0,400], "time", 300  ],
		%[ "xpos", [-500,-200,200,500], "time", 300  ],
	],
	
	// ------------------------------------------------------------------
	// 加工定義
	// ------------------------------------------------------------------
	"modifies" => %[
		"セピア" => %[grayscale:true, rgamma:2.1, ggamma:1.5],
		"魔法" => %[grayscale:true, rgamma:1.5, ggamma:1.5, bgamma:1.5],
		"モノクロ" => %[grayscale:true],
		"魔王" => %[grayscale:true, rgamma:0.7, ggamma:0.7, bgamma:0.7],
		"フルカラー" => %[grayscale:"", rgamma:"", ggamma:"", bgamma:""],

		// 立ち絵鑑賞の操作対象外キャラの塗りつぶし色0xAARRGGBBを決定します
//		"立ち絵鑑賞操作外：シャーリィ"  => %[ filter:0xE0FFFFDF ],

		],

	// ------------------------------------------------------------------
	// アクション定義
	// ------------------------------------------------------------------
	
	"actions" => %[

		// --------------------------------------------------------
		// 旧スタイル定義
		// --------------------------------------------------------

		"おじぎ" => %[
			"module" => "LayerJumpOnceActionModule",
			"vibration" => 20,
			"cycle" => 2000,
			],

		"どっきり" => %[
			"module" => "LayerHeartBeatZoomModule",
			"time" => 200,
			"zoom" => 110,
			],

//		"びょんびょん" => %[
//			"module" => "LayerJumpActionModule",
//			"vibration" => -30,
//			"cycle" => 1000,
//			],

		"あああ" => %[
			"module" => "LayerJumpActionModule",
			"vibration" => -10,
			"cycle" => 300,
			"nowait" => true,
			],

		"旧ガクガク" => %[
			"module" => "LayerVibrateActionModule",
			"vibration" => 10,
			"waitTime" => 40
			],

		"うろうろ" => %[
            "module" => "LayerWaveActionModule",
            "vibration" => 100,
            "cycle" => 5000,
			"nowait" => true,
            ],

		"あうあう" => %[
            "module" => "LayerWaveActionModule",
            "vibration" => 10,
            "cycle" => 600,
			"nowait" => true,
            ],


		"おじぎ" => %[
			"module" => "LayerJumpOnceActionModule",
			"vibration" => 20,
			"cycle" => 2000,
			],
		"どっきり" => %[
			"module" => "LayerHeartBeatZoomModule",
			"time" => 200,
			"zoom" => 110,
			],
		"びょんびょん" => %[
			"module" => "LayerJumpActionModule",
			"vibration" => -30,
			"cycle" => 1000,
			],
		"びょん×２" => %[
			"module" => "LayerJumpActionModule",
			"vibration" => -30,
			"cycle" => 1000,
			"time" => 2000,
			],
		"びょんびょん待ち無" => %[
			"module" => "LayerJumpActionModule",
			"vibration" => -30,
			"cycle" => 1000,
			"nowait" => true,
			],
		"ふわふわ" => %[
			"module" => "LayerJumpActionModule",
			"vibration" => -30,
			"cycle" => 2000,
			"nowait" => true,
			],
		"がくがく" => %[
			"module" => "LayerVibrateActionModule",
			"vibration" => 10,
			"waitTime" => 100
			],
		"がくがく継続" => %[
			"module" => "LayerVibrateActionModule",
			"vibration" => 20,
			"waitTime" => 250,
			"nowait" => true,
			],
		"画面揺れ" => %[
			"module" => "LayerVibrateActionModule",
			"vibration" => 20,
			"waitTime" => 150
			],
		"画面揺れ継続" => %[
			"module" => "LayerVibrateActionModule",
			"vibration" => 20,
			"waitTime" => 150,
			"nowait" => true,
			],
		"眩暈" => %[
			"module" => "LayerWaveActionModule",
			"vibration" => 20,
			"cycle" => 2000,
			],

		"眩暈継続" => %[
			"module" => "LayerWaveActionModule",
			"vibration" => 20,
			"cycle" => 2000,
			"nowait" => true,
			],

		"歩く" => %[
			"module" => "LayerJumpActionModule",
			"vibration" => -4,
			"cycle" => 1500,
			"nowait" => true,
			],

        "ブルブル" => %[
            "module" => "LayerWaveActionModule",
            "vibration" => 70,
            "cycle" => 35,
            "time" => 200
            ],

        "反転" => %[
            "module" => "LayerNormalRotateModule",
            "angvel" => -180,
            "time" => 500
            ],

        "縦小１" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => 50,
            "cycle" => 200
            ],

        "縦小" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => 50,
            "cycle" => 200
            ],

        "縦中" => %[
            "module" => "LayerJumpActionModule",
            "vibration" => 80,
