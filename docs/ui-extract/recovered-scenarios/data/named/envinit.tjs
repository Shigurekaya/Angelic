		"show_toper" => %[
		time: 300,
		showaction: %[ top : %[ handler:"MoveAction", start:"@+150", value:"@" , accel:-1]	],
		hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@+150" , accel:1]	]
			],

		"show_top500sec" => %[
		time: 500,
		showaction: %[ top : %[ handler:"MoveAction", start:"@+150", value:"@" , accel:-1]	],
		hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@+150" , accel:1]	]
			],

		"show_und" => %[
		time: 300,
		showaction: %[ top : %[ handler:"MoveAction", start:"@-50", value:"@" , accel:-1]	],
		hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-50" , accel:1]	]
			],

		"show_under" => %[
		time: 300,
		showaction: %[ top : %[ handler:"MoveAction", start:"@-150", value:"@" , accel:-1]	],
		hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-150" , accel:1]	]
			],

		"show_und500sec" => %[
		time: 500,
		showaction: %[ top : %[ handler:"MoveAction", start:"@-150", value:"@" , accel:-1]	],
		hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-150" , accel:1]	]
			],

		"cutin_lef" => %[
		time: 500,
		showaction: %[ left : %[ handler:"MoveAction", start:"@-70", value:"@" ]	],
		hideaction: %[ left : %[ handler:"MoveAction", start:"@", value:"@-70" ]	],
			],
		"cutin_rig" => %[
		time: 500,
		showaction: %[ left : %[ handler:"MoveAction", start:"@+70", value:"@" ]	],
		hideaction: %[ left : %[ handler:"MoveAction", start:"@", value:"@+70" ]	],
			],
		"cutin_und" => %[
		time: 500,
		showaction: %[ top : %[ handler:"MoveAction", start:"@-70", value:"@" ]	],
		hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@-70" ]	]
			],
		"cutin_top" => %[
		time: 500,
		showaction: %[ top : %[ handler:"MoveAction", start:"@+70", value:"@" ]	],
		hideaction: %[ top : %[ handler:"MoveAction", start:"@", value:"@+70" ]	]
			],



		// クロスフェードとアクションを複合したもの
		// 一応他の method でも動作しますが動作的にわかりにくくなるのでクロスフェードと合わせるのが無難です
		// 全体トランジションの場合は全てのレイヤに対して作用します
		"右クロス" => %[
		time: 300,
		method: "",
		showaction: %[ left : %[ handler:"MoveAction", start:"@-50", value:"@" ]	],
		hideaction: %[ left : %[ handler:"MoveAction", start:"@", value:"@+50" ]	],
			],

		"左クロス" => %[
		time: 300,
		method: "",
		showaction: %[ left : %[ handler:"MoveAction", start:"@+50", value:"@" ]	],
		hideaction: %[ left : %[ handler:"MoveAction", start:"@", value:"@-50" ]	],
			],
		
		// ------------------------------------------------------------------------
		// デフォルトトランジション定義
		// 標準レイヤの未指定時トランジション指定です。レイヤ側でオーバライドできます
		// ------------------------------------------------------------------------
		
		"dispTrans"=> %[ "time" =>  500, "method" => "", "sync" => true ],       // 表示・消去時
		"trans"    => %[ "time" => 1000, "method" => "", "sync" => true ],       // 画像変更時
		"modifyTrans"   => %[ "time" => 1000, "method" => "", "sync" => true ],  // 画像加工時
		"positionTrans" => %[ "time" =>  300, "method" => "", "sync" => true ],  // 位置変更時

		// ------------------------------------------------------------------------
		// 舞台変更デフォルトトランジション定義
		// 舞台変更のデフォルトトランジションは全体に影響するので共通定義となります
		// ------------------------------------------------------------------------
		
		"timeTrans"     => %[ "time" => 1000, "method" => "", "sync" => true ],  // 時間変更
		"stageTrans"    => %[ "time" => 1000, "method" => "", "sync" => true ],  // 舞台変更

		"faceTrans", %[ "time" =>  300, "method" => "", "sync", false],

		// ------------------------------------------------------------------------
		// システム画面遷移用定義
		"sysopen"  => %[ time:300, method:"universal", rule:"systrans_rule", vague:4, accel:SysTransEffectOpen  ],
		"sysclose" => %[ time:300, method:"universal", rule:"systrans_rev",  vague:4, accel:SysTransEffectClose ],
		"syspage"  => %[ time:300, method:"crossfade" ],

		],
		
	// fade の規定値:全体用 (未定義の場合埋め込み値 500)
	"fadeValue" => 1000,

	// ------------------------------------------------------------------
	// 音楽更新パラメータ
	// ------------------------------------------------------------------

	"soundTransitions" => %[
		"start" => %[
			"time" => 0,
			],
		"normal" => %[
			"time" => 1000,
			],
		"quick" => %[
			"time" => 500,
			],
		],
	
	// ------------------------------------------------------------------
	// オブジェクトのクラス定義の列挙
	// 名前は正規表現指定可能です
	// ------------------------------------------------------------------

	"classList" => [
		// 標準レイヤ用(予約名)
		%[
			"name", "layer",  // クラス名
			"type", "dlayer", // クラス型  layer:通常レイヤ dlayer:d3dレイヤ music:音楽 sound:効果音

			// フラグ指定
			// FLAG_EVENT     イベント絵：舞台変更時に自動消去
			// FLAG_STAGE     背景      ：舞台変更時に影響
			// FLAG_STAND     立ち絵    ：立ち絵消去指定、レイアウト指定の対象になる
			// FLAG_NOSTOP    リセット処理時にstopactionしない
			// FLAG_NOINIT    画像ロード時に初期化しない
			// FLAG_NORESET   画像ロード時にリセットしない
			// FLAG_INITPOS   画像ロード時に座標を初期化する
			// FLAG_INITCLIP  画像ロード時にクリッピングを初期化する
			// FLAG_ENVCOLOR    環境の加工設定を反映する
			// FLAG_TIMECOLOR   舞台の時間色加工指定を反映する
			// FLAG_DISPFRONT   表示時に自動front処理を行う
			// FLAG_NODISPAUTO  画像更新時や配置指定時にの自動表示の無効化
			// FLAG_NEWFRONT    初回表示時およびレベル変更時に自動front処理を行う※旧来互換
			// FLAG_ONLYIMAGE   初期化時など以外は画像コマンドのみうけつける
			// 未指定時は FLAG_NEWFRONT | FLAG_INITPOS | FLAG_INITCLIP;
			
			"flag", FLAG_DISPFRONT, // |FLAG_STAND,

			// モード指定
			//"shiftMode", true, // カメラシフトに反応するかどうか
			//"cameraMode",true, // カメラ移動に反応するかどうか
			"zorderZoom", false, // Z位置に応じてズーム補正する (cameraMode=true の場合に動作) 
			"zorderMove", false, // Z位置に応じて移動補正する (cameraMode=trueの場合の動作)
			//"msgwinMode", false, // メッセージ窓に所属している扱い
			//"rightHandMode", false, // 座標系の左手系/右手系の指定。左手なら上が正
			
			"initProps", %[],  // 生成時に初期化されるプロパティ指定
			"resetProps", %[], // リセット時に初期化されるプロパティ指定

			//"create", false, // 空タグでも生成する指定
			//"exclusive", false, // 排他指定・同じ場所に同時に表示できるのは1つだけになる

			//"absoluteBase" , 0, // 表示absolute のベース値
			
			// 自動トランジション指定
			"fadeValue", 300, // "fade" パラメータ指定時の標準フェード時間
			"dispTrans", %[ "time" =>  300, "method" => "", "sync" => true ], // 表示/消去時のトランジション
			//"xxxxTrans",%[ "time" =>  300, "method" => "" ], // setOptionの帰り値(dress とか pose など)に対応したトランジション指定
			"trans",     %[ "time" =>  300, "method" => "" ], // 標準のトランジション

			// イベント処理
			//"onDisp", function(disp, elm) {}, // 表示状態変更時のイベント・該当オブジェクトのコンテキストで動作
			//"onSetOptions", function(cmd, value, elm) {}, // 画像オプション変更時のイベント
			//"onPosition", function(posName, posInfo, elm) {}, // position コマンド実行時イベント
			//"onImageUpdate", function(elm){}, // 画像がなにかしらの理由で更新された場合のイベント
			
			// 画像更新時の自動アクション
			// ファイルロード時および画像オプションで更新された時に自動実行される
			//"xxxxAction", setOptionの帰り値(dressとかposeなど)に対応した自動アクション名
			//"xxxxActionParam", パラメータ
			//"imageAction", ↑のフォールバック指定
			//"imageActionParam", void; // パラメータ setAction(imageAction, imageActionParam,

//			"defaultCenter", 1,
//			"defaultOrigin", 1,
			"initOptions", %[ "center", 1 ],
			"initProps",   %[ "origin", 1 ],

			// 正規表現マッチによるコマンド追加
			"matchList", [
				%[
					// 正規表現または文字列でコマンド名を指定
					"name", /^XXXXXXXXX$/,
					// 呼び出される関数。該当オブジェクトのコンテキストで実行される
					// cmd=param  elm は全体パラメータ
					"func", function(cmd,param,elm) { /* do some command */ }
					],
				],
		],
		// zorderとカメラに反応するレイヤ
		%[
			"name", "zlayer",
			"type", "dlayer",
			"zorderZoom",true,
			"zorderMove",true,
			"cameraMode",true,
		],
		// キャラクタ用(予約名)
		%[
			"name","character",
			"type","dlayer",
			"flag", FLAG_STAND | FLAG_ENVCOLOR | FLAG_TIMECOLOR | FLAG_DISPFRONT | FLAG_NOHIDECLEAR,
			"fadeValue", 300,
			"dispTrans", %[ "time" =>  300, "method" => "", "sync" => true ], // 表示/消去時のトランジション
			"trans",     %[ "time" =>  300, "method" => "" ], // 標準のトランジション
			"dressTrans",%[ "time" =>  300, "method" => "" ], // 服装変更時
			"poseTrans", %[ "time" =>  300, "method" => "" ], // ポーズ変更時
			"faceTrans", %[ "time" =>  300, "method" => "" ], // 表情変更時
			"initProps", %["originx", 0, "originy", 0, /*"clip", """*/], // 初期指定 msgwin位置での指定状態を復帰させるために定義
			"zorderZoom",true,
			"zorderMove",true,
			"cameraMode",true,
			//"imageAction", createAutoEyeLipFlipAction, // 自動目ぱち口パク制御追加
			// 特殊マッチングコマンド定義
			"initProps", %["originx", 0, "originy", 0, /*"clip", """*/], // 初期指定 msgwin位置での指定状態を復帰させるために定義
			"matchList", [
				%[
					"name", /^[0-9][0-9][0-9][a-z]?$/,
					"func", function(cmd,param,elm) { doImageCommand("pose", cmd.substring(0,1), elm); doImageCommand("face", cmd.substring(1), elm); }
					],
				],
		],
		%[
			// 立ち絵のみ表示用継承
			"name",   "bu",
			"parent", "character",
		],

		%[
			// 時間色反映がかからないキャラ
			"name","character2",
			"parent", "character",
			"flag", FLAG_STAND | FLAG_ENVCOLOR | FLAG_DISPFRONT | FLAG_NOHIDECLEAR,
		],
		// 顔窓用(予約名)
		// キャラクタ用(顔窓専用モード)
		%[
			"name","msgwin",
			"type","layer",
			"flag", FLAG_STAND | FLAG_ONLYIMAGE | FLAG_NOHIDECLEAR, // コマンドに反応しない
			//"flag", FLAG_STAND,
			"shiftMode",false,
			"zorderZoom", false,
			"zorderMove", false,
			"cameraMode", false,
			"msgwinMode", true, // メッセージ窓処理処理に反応する
			"fadeValue", 300,
			"dispTrans", "notrans", // 表示/消去時のトランジション
			"trans",     %[ "time" =>  300, "method" => "" ], // 標準のトランジション
			"dressTrans",%[ "time" =>  300, "method" => "" ], // 服装変更時
			"poseTrans", %[ "time" =>  300, "method" => "" ], // ポーズ変更時
			"faceTrans", %[ "time" =>  300, "method" => "" ], // 表情変更時
			"initProps", %["originx", -480, "originy", 320, /*"clip", "facemask"*/],
			"resetProps", %["xpos",0, "ypos", 0, "zpos", 0, "zoom", 90 ],
			"exclusive",true, // 排他指定
			"absoluteBase" , 1000001, // メッセージ窓の上
			// 特殊マッチングコマンド定義
			"matchList", [
				%[
					"name", /^[0-9][0-9][0-9][a-z]?$/,
					"func", function(cmd,param,elm) { doImageCommand("pose", cmd.substring(0,1), elm); doImageCommand("face", cmd.substring(1), elm); }
					],
				],
		    "filePrefix", "face"
			
			],
		// 背景用
		%[
			"name","stage",
			"type","dlayer",
			"flag", FLAG_STAGE | FLAG_INITPOS | FLAG_ENVCOLOR,
			"zorderZoom",false,
			"zorderMove",true,
			"cameraMode",true,
		],
		// stageと同様の指定だが FALG_STAGE が無いので背景指定に自動追従はしないレイヤ
		%[
			"name","stage2",
			"parent", "stage",
			"flag", FLAG_INITPOS | FLAG_ENVCOLOR,
		],
		%[
			"name","event",
			"type","layer",
			"flag", FLAG_EVENT | FLAG_INITPOS | FLAG_ENVCOLOR,
			"zorderZoom", false,
			"zorderMove", false,
			"cameraMode",true,
			"dispTrans", "500sec",       // イベント絵表示のデフォルト
			"trans"    , "300secNosync", // イベント絵変更のデフォルト
		],
		// eventと同様の指定だが FALG_EVENT が無いので背景指定に自動追従はしないレイヤ
		%[
			"name","event2",
			"parent","event",
			"flag", FLAG_INITPOS,
		],
		// 固定用
		%[
			"name","fixcaption",
			"parent","event2",
			"cameraMode",false,
			"dispTrans", "",
			"trans"    , "",
		],
		// エフェクト用
		%[
			"name","effect",
			"type","layer",
			"flag", 0,
			"initProps", %["level", 5],
			"dispTrans", %[ "time" => 500, "method" => "" ], // 表示/消去時のトランジション
			"trans",     %[ "time" => 500, "method" => "" ], // 標準のトランジション
			"create", true, // 空タグでも生成する指定
		],
		%[
			"name","effect2",
			"type","layer",
			"flag", 0,
			"cameraMode", true,
		],
		// パーティクル用
		%[
			"name","particle",
			"type","layer",
			"flag", 0,
			"zorderZoom", false,
			"zorderMove", false,
			"dispTrans","notrans",
			"trans","notrans",
			"create", true, // 空タグでも生成する指定
		],
		// 最前面での動画再生用
		%[
			"name","movie",
			"type","layer",
			"flag", 0,
			"zorderZoom", false,
			"zorderMove", false,
			"cameraMode",true,
//			"initProps", %["level", 5],
			"dispTrans","normal",
			"trans","normal",
//			"defaultCenter", 1,
//			"defaultOrigin", 1,
			"initOptions", %[ "center", 1 ],
			"initProps",   %[ "origin", 1 ],
		],
		// BGM用
		%[
			"name","bgm",
			"type","music",
			"volumeName", "downbgm",   // 参照ボリューム名 ※音量ダウンに追従
			"eventFlag", true,
			"loop",true,
			"playTrans", "start",  // 再生時のトランジション
			"stopTrans", "normal",// 停止時のトランジション
			"trans", "normal",    // 切り替え時のトランジション
			"saveFlag", "true",   // 再生記録をするかどうか
			],
		// ループ効果音用
		%[
			"name","loopse",
			"type","music",
			"volumeName", "se",   // 参照ボリューム名
			"loop",true,
			"playTrans", "start", // 再生時のトランジション
			"stopTrans", "normal",// 停止時のトランジション
			"trans", "normal",    // 切り替え時のトランジション
			],
		// 通常効果音用
		%[
			"name","se",
			"type","sound",
			"track",8
		],

		// BGV用
		%[
			"name","bgv",
			"type","sound",
			"volumeName","bgv",  // 参照ボリューム名
			//"volume",50,         // ボリューム補正値
			"track", 5           // トラック数
		],
		%[
			"name", "endsong",
			"type", "music",
			"volumeName", "movieaudio",   // 参照ボリューム名 ※音量ダウンに追従
			"loop", false,
			"saveFlag", true,
			],
		
		// H効果音クラス
		%[
			"name","hse",          // 名前
			"type","sound",       // クラス種別
			"volumeName", "se",   // 参照ボリューム名 ※kag.hse{volume,enable}はcustomで存在
			"track", 5            // トラック数
		],
		// Hループ効果音クラス
		%[
			"name","hloopse",
			"parent", "loopse",
			"volumeName", "se",   // 参照ボリューム名
		],

		
		// ------------------------------
		// 座標系違いの定義
		// ------------------------------

		// 原点は画面中央・回転中心はは左上のレイヤ
		// parent 指定で既存の定義を元にすることができます。
		// ※parentはかならず先に記述しておく必要があります
		%[
			"name", "centerlayer",
			"parent", "layer",
//			"defaultCenter", 9,
//			"defaultOrigin", 9,
			"initOptions", %[ "center", 9 ],
			"initProps",   %[ "origin", 9 ],
			"flag", 0,
			"trans",     %[ "time" =>  300, "method" => "", "nosync", true ], // 標準のトランジション
		],
		
		// 左上原点のレイヤ例
		%[
			"name","base",
			"parent","layer",
			"cameraMode",true,
//			"defaultCenter", 1,
//			"defaultOrigin", 1,
			"initOptions", %[ "center", 1 ],
			"initProps",   %[ "origin", 1 ],
		],

		// 単発指定キャラレイヤ例
		%[
			"name","clayer",
			"type","layer",
//			"flag", FLAG_STAND | FLAG_ENVCOLOR | FLAG_TIMECOLOR,
			"flag", FLAG_STAND,
			"zorderZoom", false,
			"zorderMove", false,
			"cameraMode",true,
//			"defaultCenter", 1,
//			"defaultOrigin", 1,
			"initOptions", %[ "center", 1 ],
			"initProps",   %[ "origin", 1 ],
			"fadeValue", 300,
			"dispTrans", %[ "time" =>  300, "method" => "", "sync" => true ], // 表示/消去時のトランジション
			"trans",     %[ "time" =>  300, "method" => "" ], // 標準のトランジション
		],

		// ------------------------------
		// システム演出用
		%[
			"name","watermark",
			"type","layer",
			"flag", 0,
			"shiftMode",false,
			"zorderZoom",false,
			"zorderMove", false,
			"cameraMode", false,
			"dispTrans","notrans",
			"trans","notrans",
			"absoluteBase" , 1001001, // メッセージ窓の上
		],
		// ------------------------------
		// 立ち絵鑑賞背景（INITPOSなしstage）
		%[
			"name", "exchview_bg",
			"parent","stage",
			"flag", FLAG_STAGE | /*FLAG_INITPOS |*/ FLAG_ENVCOLOR,
			"zorderZoom",false,
			"zorderMove",false,
			"cameraMode",false,
			"resetProps", %[ "xpos", 0, "ypos", 0 ], // reset時に座標を初期化する仕組みに変更
		],
		// ------------------------------
		// システム用
		%[
			"name","system",
			"type","layer",
			"flag", 0,
			"shiftMode",  false,
			"zorderZoom", false,
			"zorderMove", false,
			"cameraMode", false,
			],

		// チャットスクリーン
		%[
			"name","phoneclass",
			"parent", "system",
			"dispTrans","normal",
			"trans","normal",
			"absoluteBase" , 1000000-10, // メッセージ窓の下
		],
	],

	// ------------------------------------------------------------------
	// オブジェクト名前定義
	// 名前に合致する未定義タグがあった場合は、
	// 指定された初期化パラメータでオブジェクトが生成されます
	// 名前は正規表現指定可能です
	// ------------------------------------------------------------------
	"objectList" => [
		// stageは背景用レイヤ
		%[
			"name", "stage",
			"class", "stage",
			"init",  ["file", "base.stage", "zorder", 30, "hide", true], // level0より少し下
		],
		// 舞台複数処理用・一時利用用なのでロックさせない
		%[
			"name", "stage2",
			"class", "stage2",
			"init",  ["file", "base.stage", "zorder", 52, "hide", true], // level0より少し下
		],
		%[
			"name", "stage3",
