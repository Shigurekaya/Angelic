	// モーション中に "se名前" のアクションを配置しておくと、motionseobj のオブジェクト(Soundオブジェクト)
	// を使ってそのサウンドを再生する
	"motionseobj", "se",
	"motionse", %[
//		"001", %[storage:"se001", "volume", 50],
//		"002", %[storage:"se002", "volume", 30],

		"001", %[storage:"【システム】ロゴ(SOUR)", "volume", 50],
		"002", %[storage:"♪キラキラ２", "volume", 50],

		"015", %[storage:"☆コミカル20(-3)", "volume", 40],
		"202", %[storage:"☆コミカル29", "volume", 50],
		"2022", %[storage:"★倒れる（ベッド）", "volume", 100],
		"302", %[storage:"♪スマホ／シャッター", "volume", 50],
		"401", %[storage:"☆コミカル20", "volume", 50],
		"4012", %[storage:"☆コミカル29", "volume", 50],
		"402", %[storage:"★ぶつかる５", "volume", 50],
		"4022", %[storage:"★殴る６", "volume", 50],
		"602", %[storage:"☆コミカル15", "volume", 50],





		],
	
	// ------------------------------------------------------------------
	// クリッピングマスク定義用
	// ------------------------------------------------------------------

	"clips" => %[
//		"clipstar", %[ image:"star.png" ],
		"cliparea", %[ left:10, top:10, width:100, height:100 ],
		],

	// ------------------------------------------------------------------
	// エモーション定義
	// ------------------------------------------------------------------

	// エモーション標準座標
	"emotionX" => 0, // エモーション基準位置（ポーズで調整可能）
	"emotionY" => 0, // エモーション基準位置（ポーズで調整可能）

	// エモーション画像定義
	"emotions" => %[
		"！" => %[
			"xoff" => 0,                // 基準位置からの相対位置X
			"yoff" => 0,                // 基準位置からの相対位置Y
			"image" => "びっくり",      // 画像名 LEVEL の部分はオブジェクトのlevelで置換される
			 imageRev: "びっくり_rev",    // 反転時画像名・反転指定はポーズ別定義で行う
			"action" => "びょん大",         // エモーションに適用するアクションを指定
			"time" => 1500            // エモーション消去までの時間・指定するとopacity制御で消去されます
			],

		],
	
	// ------------------------------------------------------------------
	// フィルタ用コマンド定義
	// ------------------------------------------------------------------

	"filterList" => [
		%[
			// 名前指定
			"name", "allimage",
			// フィルタ指定: 文字列:他の定義を参照 関数:帰り値が真なら参照 正規表現:名前でマッチング。配列で複数指定可能
			"filter", function(obj, elm) { return obj instanceof "KAGEnvImage" && (elm.env === void || elm.env == obj.env.name); },
			// コマンド実行前に排除するタグ・判定などで使ったものを誤動作防止で処理。配列で複数指定可能。
			"remove", "env",
		],
		%[
			"name", "allchar",
			// 継承すると親の条件を満たした後追加でしぼりこむ
			"parent", "allimage",
			"filter", function(obj,elm) { return obj.className == "character"; }
		],
		%[
			"name", "allbase",
			"parent", "allimage",
			"filter", function(obj,elm) { return obj.className == "stage" || obj.className == "event"; }
		],
		%[
			"name", "allse",
			"filter", function(obj,elm) { return obj.className == "se" || obj.className == "lse"; }
		],
		%[
			"name", "allfixcaption",
			"filter", function(obj,elm) { return obj.className == "fixcaption"; }
		]
	],

	// ------------------------------------------------------------------
	// 変数名対応マップ
	// E-mote で変数名に大文字が入っているのでそれに対する対応用
	// ------------------------------------------------------------------

	"variableMap", %[
		"face_eye_lr","face_eye_LR",
		"face_eye_ud","face_eye_UD",
		"head_lr","head_LR",
		"head_ud","head_UD",
		"body_lr","body_LR",
		"body_ud","body_UD",
		"move_lr","move_LR",
		"move_ud","move_UD",
		"bust_lr","bust_LR",
		"bust_ud","bust_UD",
		"hair_lr_front","hair_LR_front",
		"hair_lr_m_front","hair_LR_M_front",
		"hair_ud_front","hair_UD_front",
		"hair_lr_sidel","hair_LR_sideL",
		"hair_lr_m_sidel","hair_LR_M_sideL",
		"hair_ud_sidel","hair_UD_sideL",
		"hair_lr_sider","hair_LR_sideR",
		"hair_lr_m_sider","hair_LR_M_sideR",
		"hair_ud_sider","hair_UD_sideR",
		"hair_lr","hair_LR",
		"hair_lr_m","hair_LR_M",
		"hair_ud","hair_UD",
		"quake_lr","quake_LR",
		"quake_lr_m","quake_LR_M",
		"quake_ud","quake_UD",
		"quake_lr_spare","quake_LR_spare",
		"quake_lr_m_spare","quake_LR_M_spare",
		"quake_ud_spare","quake_UD_spare",
		],

	// 値がステップ値な変数
	"stepVariable", %[
		"face_cheek", true,
		"face_mouth", true,
		"face_tears", true,
		"face_eye_hi", true,
	],


]
