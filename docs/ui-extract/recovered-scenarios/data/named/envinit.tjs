		// パラメータ指定型トランジション定義例
		// %distance で距離制御可能
		"showslide" => %[
		time: 1000,
		showaction: %[ left : %[ handler:"MoveAction", start:"&@+${distance}", value:"@", distance:50 ]	],
		hideaction: %[ left : %[ handler:"MoveAction", start:"@", value:"&@-${distance}", distance:50 ]	]
			],

