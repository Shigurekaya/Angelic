            ],

        "ペシ" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => 6,
            "cycle" => 200
            ],

        "殴り" => %[
            "module" => "LayerJumpActionModule",
            "time" => 100,
            "vibration" => 6,
            "cycle" => 50
            ],

        "横小１" => %[
            "module" => "LayerWaveOnceActionModule",
            "vibration" => 14,
            "cycle" => 200
            ],

        "怒声" => %[
            "module" => "LayerJumpActionModule",
            "time" => 200,
            "vibration" => 6,
            "cycle" => 100
            ],

        "背景怒声" => %[
            "module" => "LayerJumpActionModule",
            "time" => 200,
            "vibration" => 30,
            "cycle" => 50
            ],

        "驚き" => %[
            "module" => "LayerVibrateActionModule",
            "time" => 74,
            "vibration" => 8,
            "waitTime" => 40
            ],

        "ジャンプ" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => -50,
            "cycle" => 300
            ],

        "ビク" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => -4,
            "cycle" => 150
            ],

        "！？" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => -10,
            "cycle" => 200
            ],

        "うぐっ" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => -6,
            "cycle" => 100
            ],

        "衝撃" => %[
            "module" => "LayerVibrateActionModule",
            "time" => 250,
            "vibration" => 30,
            "waitTime" => 20
            ],

        "小揺れ" => %[
            "module" => "LayerVibrateActionModule",
            "time" => 200,
            "vibration" => 10,
            "waitTime" => 20
            ],

        "ガツ" => %[
            "module" => "LayerVibrateActionModule",
            "time" => 150,
            "vibration" => 50,
            "waitTime" => 20
            ],

        "画面揺らし" => %[
            "module" => "LayerVibrateActionModule",
            "time" => 250,
            "vibration" => 50,
            "waitTime" => 20
            ],

        "画面揺れ長" => %[
            "module" => "LayerVibrateActionModule",
            "vibration" => 50,
            "waitTime" => 20
            ],

        "画面揺らし大" => %[
            "module" => "LayerVibrateActionModule",
            "time" => 300,
            "vibration" => 70,
            "waitTime" => 20
            ],


        "飛ぶ" => %[
            "module" => "LayerJumpOnceActionModule",
            "vibration" => -200,
            "cycle" => 1000 ,
            ],


		"ガクガク" => %[
			"left"	=> %[ handler:"RandomAction", vibration:10, waittime:20],
			"top"	=> %[ handler:"RandomAction", vibration:10, waittime:20],
			],
		
		"ゆさゆさ" => %[
			"left"	=> %[ handler:"SinAction", vibration: -12, cycle: "%cycle|800", ],
			"top"	=> %[ handler:"SinAction", vibration: 4, cycle: "%cycle|800", ],
			 ],
		
		"カメラガクガク" => %[
			"camerax"	=> %[ handler:"RandomAction", vibration:10, waittime:20],
			"cameray"	=> %[ handler:"RandomAction", vibration:10, waittime:20],
			],

		"シフトガクガク" => %[
			"shiftx"	=> %[ handler:"RandomAction", vibration:10, waittime:20],
			"shifty"	=> %[ handler:"RandomAction", vibration:10, waittime:20],
			],

		
		// --------------------------------------------------------
		// 新スタイル定義
		// --------------------------------------------------------

		"移動テスト" => %[ // 現在位置から+300の位置に500ms かけて移動
						   "time" => 500,
						   "left" => %[ handler:"MoveAction", value:"@+300" ],
						   ],

		"パス移動テスト" => %[ // 複数移動の一括指定
						   "time" => 1000,
						   "left" => %[ handler:"PathAction", value:"@+300,@-300,@+100" ],
						   ],

		"パス移動テスト2" => %[ // KAGのmove互換表記
								"time" => 3000,
								"path" => "(-400,400,128)(-400,-400,100)(0,0,256)",
								"spline" => true,
						   ],
		
		"回転テスト" => %[ // 1000msの間回転
						   "time" => 1000,
						   "rotate" => %[ handler:"TriangleAction", vibration:360,  ontime:1000, offtime:0 ]
						   ],

		"スローズーム" => %[ // 20000msの間ちょっとずつズーム
						   "time" => 20000,
						   "zoom" => %[ handler:"MoveAction", value:110 ]
						   ],

		"タイルスライド" => %[
			"$tilex" => %[ handler:"LoopMoveAction", max:800, loop:2000 ],
			"$tiley" => %[ handler:"LoopMoveAction", max:600, loop:2000 ]
			],

		"横スライド" => %[
			"$tilex"  => %[ handler:"LoopMoveAction", max:2700, loop:2700 ],
			"nowait" => true,
			],
		
		// --------------------------------------------------------
		// 連続アクション
		// --------------------------------------------------------

		"連続テスト" => [
			// 座標移動の初期値は全アクション実行の前の位置になるのに注意
			%[ // 現在位置から +300 の位置に 500ms かけて移動
			   "time" => 500,
			   "left" => %[ handler:"MoveAction", value:"@+300" ],
				],
			%[ // 現在位置から -300 の位置に 500ms かけて移動
				"time" => 1000,
				"left" => %[ handler:"MoveAction", value:"@-300" ],
				],
			%[ // 現在位置から +300 の位置に 500ms かけて移動
				"time" => 1000,
				"left" => %[ handler:"MoveAction", value:"@+300" ],
			   ],
			%[ // 現在位置に 500ms かけて移動
			   "time" => 1000,
			   "left" => %[ handler:"MoveAction", value:"@" ]
			   ]
			],

		"連続テスト２" => [ // アクション名で連続指定も可能
							"移動テスト", "回転テスト" ],

		"背伸び" => [
			%[ "top" => %[ handler:"MoveAction", value:"@+6", time:1000, accel:"acdec"] ],
			%[ "top" => %[ handler:"MoveAction", value:"@+3", time:300, accel:1] ],
			%[ "top" => %[ handler:"MoveAction", value:"@", time:500, accel:-1] ],
			],
		
		"がっくり" => [
			%[ "top" => %[ handler:"MoveAction", value:"@-10", time:500, accel:1] ],
			%[ "top" => %[ handler:"MoveAction", value:"@-4", time:300, accel:-1] ],
			],

		"ふるふる" => [
			%[ "left" => %[ handler:"MoveAction", value:"@-4", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+4", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@-4", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@+4", time:200, accel:"acdec"] ],
			%[ "left" => %[ handler:"MoveAction", value:"@", time:200, accel:"acdec"] ],
			],

		"こくこく" => [
			%[ "top" => %[ handler:"MoveAction", value:"@-10", time:200, accel:"acdec"] ],
			%[ "top" => %[ handler:"MoveAction", value:"@", time:200, accel:"acdec"] ],
			%[ wait:5 ],
			%[ "top" => %[ handler:"MoveAction", value:"@-10", time:200, accel:"acdec"] ],
			%[ "top" => %[ handler:"MoveAction", value:"@", time:200, accel:"acdec"] ],
			],


		"否定" => [
			%[
				"time" => 250,
				 "left" => %[ handler:"MoveAction", value:"@-20" ],
				],
			%[
				"time" => 500,
				"left" => %[ handler:"MoveAction", value:"@+20" ],
				],
			%[
				"time" => 250,
				"left" => %[ handler:"MoveAction", value:"@" ],
				],
			],

		"揺れ" => [
			%[
				"time" => 100,
				 "left" => %[ handler:"MoveAction", value:"@-4" ],
				],
			%[
				"time" => 200,
				"left" => %[ handler:"MoveAction", value:"@+4" ],
				],
			%[
				"time" => 100,
				"left" => %[ handler:"MoveAction", value:"@" ],
				],
			],

		"もじもじ" => [
