		],
		// チャット用
		%[
			"name", SystemConfig.phoneChatEnvObjectName,
			"class", "phoneclass",
			"init", ["file", SystemConfig.phoneChatBaseImageFile, "script", "%s,%d,%d".sprintf(SystemConfig.phoneChatImageScript, kag.scWidth, kag.scHeight)],
		],
	],
	// チャット用加工
	"scripts" => %[
		SystemConfig.phoneChatImageScript => global.PilePhoneChatScreen incontextof null,
		],

	// ------------------------------------------------------------------
	// タグ名自動マッチ処理定義
	// 名前に合致する未定義タグがあった場合は
	// 指定したオブジェクトに対して storage= コマンドとして処理されます
	// 該当オブジェクトが無い場合は自動生成されます
	// 名前は正規表現指定可能です
	// ------------------------------------------------------------------
	"filenameList" => [
		%[
			"name", /^bgm.+/,
			"object", "bgm",
		],
		%[
			"name", /^se.+/,
			"object", "se",
		],
		%[
			"name", /^ev.+/,
			"object", "ev",
		],
		%[
			"name", /^bg[0-9]/,
			"object", "bg",
		],
		%[
			"name", /^sd.+/,
			"object", "sd",
		],
	],

	// ------------------------------------------------------------------
	// モーション画像の単発名定義
	// storage:画像名
	// colorkey: カラーキー指定
	// asdfile: asdfile を明示指定
	// tile: タイル画像指定 width,height も併用
	// width,height,color 指定色での塗りつぶし画像
	// その他の値ロード時の追加オプションパラメータとして指定されます
	// ------------------------------------------------------------------
	"motions" => %[

		// 単色画像定義
		"lay_white" => %[
			"width", 1280,
			"height", 720,
			"color", 0xffffff,
			],
		"lay_black" => %[
			"width", 1280,
			"height", 720,
			"color", 0x000000,
			],
		"lay_red" => %[
			"width", 1280,
			"height", 720,
			"color", 0xff0000,
			],

		"amvfile" => %[
			"fliptype", "amovie",
			"loop", true,
			"storage", "alphamovie.amv",
			"width", 1280,
			"height", 720
			],

		"ノイズ" => %[
			"noise",100, // interval
			"width",1920,
			"height",1080,
			//"resolution",50, // 解像度半分指定すると実サイズ2倍に
			],
		
		"title_bg0",     %[ storage:"title_bg.mtn",  chara:"title_bg",  motion:"title",     noseparate:false, altStorage:"title_bg0_logo.pbd", variables:"%[language:_uilangnum]" ],
		"title_bg1",     %[ storage:"title_bg2.mtn", chara:"title_bg2", motion:"title",     noseparate:false, altStorage:"title_bg1_logo.pbd", variables:"%[language:_uilangnum]" ],
		"title_bg2",     %[ storage:"title_bg3.mtn", chara:"title_bg3", motion:"title_0",   noseparate:false, altStorage:"title_bg2_logo.pbd", variables:"%[language:_uilangnum]" ],
