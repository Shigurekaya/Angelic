KAGLoadScript("append_init.tjs");

// [XXX]
var FullHDMode = true;
function SizeCoef (n, toreal) { var r = n*1.5; return toreal ? r : int(r); }

@if (DEBUG && !PACKED)
// scenario/ 再帰フォルダ追加
if (debugWindowEnabled && !inXP3archivePacked) {
	addAutoPathRecursive(System.exePath+"scenario/", false, tkdlVerbose);
	addAutoPathRecursive(System.exePath+"scenario_forSteam/", false, tkdlVerbose);
}
@endif
