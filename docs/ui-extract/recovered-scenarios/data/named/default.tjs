		var ovl  =  @"000:f_${flag}|002:v_${flag}|001:v_${flag}";
		/**/ovl +=  "|000:f_nbase|002:v_nbase|001:n_nbase";
		/**/ovl += @"|000:${lang}nf_${flag}|002:${lang}nv_${flag}|001:${lang}nn_${flag}";
		elm.overlay = ovl;
		@endif
		elm.exp = @"tf.afterstory='${flag}',kag.current.names.${tag}.toggle=true";
	}
	return;
	function hack(tag, st) {
		var btn = kag.current.names[tag];
		if (btn) with (btn) {
			//dm("hack", tag, btn, st);
			.onPaint = global.Layer.onPaint;
			.getImageDrawState = function(st) { return st; };
			.drawState(st);
		}
	}
}

// シナリオ検索が開く追加条件（立ち絵鑑賞オープン後）
function CheckSearchOpened() {
@if (CUSTOM_USE_R18HACK)
	if (!checkAdult()) return checkAllClear;
@endif
	return tf.allseen ||
		(   GetClearFlag("after_").all &&
			// [XXX] アフター1/2を考慮する場合は個々に条件を列挙
			true);
}

// クリア条件
///property checkAnyClear { getter {...} }
///property checkAllClear { getter {...} }

// ランダムアイキャッチ選択
function _get_eyecatch_random_image(sel = tf.lastSystemVoiceChara, format="アイキャッチ%srand", unknown = "サブ") {
	try { if (world_object.parserConverting) sel = ""; } catch {} // [XXX] コンバート中は最後のシステムボイスキャラに依存する問題があるため強制
	var chara = sel != "" ? SystemVoice.selectChara(sel) : unknown;
	var r = format.sprintf(chara);
	dm("GetEyecatchRandomImage", sel, chara, r);
	return r;
}
// [メガネ選択]マクロ翻訳
function _megane_select(onoff, defval, key = "SceneModeMeganeSelect") {
	var r = GetSysLangText(key + (onoff?"_on":"_off"), CurrentLanguageTag, null);
	return r != "" ? r : defval;
}

// 環境初期化処理
function initialEnvironment(isFirst = false, tag)
{
	var section = function (sec) { return tag == "" || tag == sec; } incontextof %[ tag:tag ];
	// "01basic", "02image", "03game1", "04game2", "05text", "06sound", "07dialog", "08mouse", "09keyboard", "10gamepad"

	// 簡易設定用初期化パラメータ
	var BASIC =
		%[
		sqscr       : "off",				// 画面サイズ ("off" = 16:9 / "on" = 4:3)
		textspeed   :  50,					// テキスト速度 (min:0～10:max)
		autospeed   :  50,					// オート速度   (min:0～10:max)
		allskip     : false,				// 未読スキップ許可 (true:有効, false:無効)
		wavevolume  : 100,					// 全体音量
		bgmvolume   :  50,					// BGM音量
		sevolume    :  80,					// SE音量
		voicevolume : 100,					// ボイス音量
		movievolume :  50,					// ムービー音量
		moviesample : false,				// ムービーサンプル再生
		];

	// 簡易設定タブ
	if (section("01basic") && tag != "") {
		// デフォルト値は↑のBASIC設定を書き換えてください
		setSysArgMenuItem("sqscr", BASIC.sqscr) if (!isFirst);
		kag.textspeed   = BASIC.textspeed;
		kag.autospeed   = BASIC.autospeed;
		kag.allskip     = BASIC.allskip;
		kag.waveenable  = true;			kag.wavevolume  = BASIC.wavevolume;
		kag.bgmenable   = true;			kag.bgmvolume   = BASIC.bgmvolume;
		kag.seenable    = true;			kag.sevolume    = BASIC.sevolume;
		kag.voiceenable = true;			kag.voicevolume = BASIC.voicevolume;
		kag.movieAudioEnable = true;	kag.movieAudioVolume = BASIC.movievolume;
		SystemConfig.movieAudioSample = BASIC.moviesample;
	}

	// 画面表示タブ
	if (section("02image")) {

		// 画面サイズ

		// 画面効果
		kag.noeffect = false;

		// ESC/スクランブル機能選択
		sf.escapeMode = 0;
		sf.scrambleMode = 0;

		if (!isFirst) {
			setSysArgMenuItem("sqscr", BASIC.sqscr);			// 画面サイズ (16:9/4:3) ⇒ BASIC設定を書き換えてください
			setSysArgMenuItem("scanim", "yes") if (!enableSceneAnimEffect); // 背景アニメ
			setSysArgMenuItem("stayontop", "no");		// 常に手前
		}

		// 画面アイテムの表示
		with (SystemConfig) {
			.showAutoSkipMark = true;			// オートスキップ状態進行表示アイコン;

			.ChapterAutoHideTime = 5; // Chapterを常に表示
			.showTextVoiceProgress = true; // 進行バー
			.showVoiceReplay = true; // 音声リピート
			.showVoiceSave   = true; // お気に入りボイス登録

			QuickMenuLocked = true if (!isFirst); // ウィンドウメニュー
		}

		// 曲名表示
		SystemConfig.MusicTitleAutoHideTime = 3; // -1:なし, 0:常時, 1～:指定秒

		// 話者の表情を表示
		world_object.faceMode = true;

		// タッチパネルUI
		kag.scflags.touchUI_enabled = void; // void:タッチデバイスの有無で自動決定, true:ON, false:OFF

		SystemConfig.quickConfAutoOpen = true; // ポップアップ表示
	}

	// ゲーム進行１タブ
	if (section("03game1")) {

		// 既読自動スキップ
		kag.enterSkipOnReadedLabel = false;		// 既読自動スキップ (true:有効, false:無効)
		kag.enterSkipNoDisp = false;			// 既読自動スキップの機能選択 (true:ジャンプ, false:スキップ)

		// ダイアログマウス自動移動
		if (!isFirst) setSysArgMenuItem("curmove", "yes");

		// 自動移動場所
		SystemConfig.DialogForcusForceYes = false;

		// マウスカーソル自動消去
		kag.scflags.hideMouseCursorTime = 0;

		SystemConfig.saveLoadDblClick = false; // セーブロード実行動作 false:シングル, true:ダブル

		SystemConfig.flowchartForceItemOpen = false; // フローチャート未到達箇所表示

		// Hシーン選択肢固定
		sf.hselectFix = false;
		sf.hselectOUTIN = false;				// 外だし・中だし
		sf.hselectMOUTHFACE = true;				// 口内・顔面

		if (!isFirst) {
			setSysArgMenuItem("stopdeactive", "no"); // 非アクティブ時動作
		}
		// プレビュー切り替え
		kag.appIconicPreview = false;

		// サスペンド機能
		SystemConfig.suspendBootEnabled = true;
	}

	// ゲーム進行２タブ
	if (section("04game2")) {
		kag.drawspeed     = 1;					// ゲーム再生速度 (min:1.0～)
		kag.voicespeed    = 1;					// 音声再生速度   (min:1.0～)
		kag.skipspeed     = 0;					// スキップ速度   (min:1.0～0:max)

		// ボイス速度をゲーム再生速度と連動する
		kag.scflags.voiceSpeedSync = false;

		// スキップスタイル
		kag.skipStyle = 0;

		// ドラマチックモード
		kag.dramaticMode = 0;
		if (!isFirst) {
			SystemConfig.TextSpeechEnabled = false; // 外部音声ツール連動
			UpdateTextSpeech();

			SaveSnapshotLayer('set|NoDialog:0'); // スナップショット保存ダイアログ表示
		}

		SystemConfig.movieRClickSkip = true;  // 右クリックのムービースキップ
		SystemConfig.movieSkipOnSkip = false; // スキップ時のムービースキップ
	}

	// テキストタブ
	if (section("05text")) {
		kag.textspeed   = BASIC.textspeed;		// テキスト速度 (min:0～10:max) ⇒ BASIC設定を書き換えてください
		kag.autospeed   = BASIC.autospeed;		// オート速度   (min:0～10:max) ⇒ BASIC設定を書き換えてください
		kag.atextwait   = 25;					// オート1文字あたり追加待ち時間(ms) 0～100ms

		// オートモードパターン
		kag.autoModeWaitVoice = 0;				// 0:ノーマル 1:ボイス 2:スピード

		kag.allskip       = BASIC.allskip;		// 未読スキップ許可 (true:有効, false:無効) ⇒ BASIC設定を書き換えてください
		kag.noForceSkipUnread = false;			// CTRLスキップタイプ (true:既読のみ, false:全て)

		kag.afterauto     = true;				// 選択後の auto (true:継続, false:停止)
		kag.afterskip     = true;				// 選択後の skip (true:継続, false:停止)

		sf.windowOpac  = (int)( 75 *256/100);		// ウィンドウ不透明度

		//kag.chDefaultFace = global.MessageDefaultFontFace;	// フォント
		kag.resetLanguageFont(); // フォントリセット

		SystemConfig.disableHSceneWindow = false; // Ｈシーン専用ウィンドウ false:有効, true:無効
	}

	// テキストタブ内カラー設定
	if (section("05text") || section("color")) {
		// ゲーム特化
		with (kag.scflags) {
			var cols = SystemConfig.DefaultColors;
			// 色はこのファイルの冒頭にある定義を変更してください（下記は編集禁止）
			.color_win  = cols.win ;	// ウィンドウ色
			.color_owin = cols.owin;	// ウィンドウ色（他者視点）
			.color_hwin = cols.hwin;	// ウィンドウ色（他者視点）
			.color_text = cols.text;	// （未読）文字色
			.color_read = cols.read;	// 既読文字色

			// コンフィグ画面の補助情報を初期化
			.currentColorTag = "text";
			delete .hsv_win;
			delete .hsv_owin;
			delete .hsv_hwin;
			delete .hsv_text;
			delete .hsv_read;
		}
	}

	// サウンドタブ
	if (section("06sound")) {
		// 音の有効
		kag.waveenable  = true;
		kag.bgmenable   = true;
		kag.seenable    = true;
		kag.sysseenable = true;
		kag.voiceenable = true;
		kag.bgvenable   = true;
		kag.bgv2enable  = true;
		kag.movieAudioEnable = true;

		// 音量設定
		kag.wavevolume  = BASIC.wavevolume;		// 全体音量 ⇒ BASIC設定を書き換えてください
		kag.bgmvolume   = BASIC.bgmvolume;		// BGM音量 ⇒ BASIC設定を書き換えてください
		kag.sevolume    = BASIC.sevolume;		// SE音量 ⇒ BASIC設定を書き換えてください
		kag.syssevolume = 50;					// システムSE音量
		kag.voicevolume = BASIC.voicevolume;	// ボイス音量 ⇒ BASIC設定を書き換えてください
		kag.bgvvolume   = 70;					// BGV音量通常   (min:0～100:max)
		kag.bgv2volume  = 70;					// BGV音量Hシーン(min:0～100:max)
		kag.movieAudioVolume = BASIC.movievolume;// ムービー音量 ⇒ BASIC設定を書き換えてください
		SystemConfig.movieAudioSample = BASIC.moviesample;	// サンプル再生有無

		kag.bgmdownlevel = 50;					// BGMダウン時の音量を下げる割合 [0-100%]（画面の表示の値とは違うので注意）

		kag.bgmdown   = false;					// 音声再生時にBGM音量を(true:下げる, false:下げない)

		kag.nosewhenskip = true;				// スキップ時の単発SE (true:鳴らさない, false:鳴らす)

		kag.voicecut = true;					// ボイスをカットを有効
		kag.voicecutpage = true;				// カットするタイミング（true:ページ消去時にカット, false:名前表示時にカット)

		SystemConfig.VoiceEffectEnabled = true; // ボイスエフェクト

		// システムボイス
		with (SystemVoice) {
			.enabled = true;
			.pervolume = 100;
			if (SystemConfig.SystemVoiceTypes !== void) {
				.chartype = void; // 先頭の定義がデフォルト値
			} else {
				.charmask = .charmaskdefault; // mask (cf. sysse.ini: syvo.defkeys
			}

			.setDefaultSettings(); // ボイス再生箇所の設定をリセット
		}
		SystemConfig.lowPrioritySystemVoice = false; // 本編ボイス再生中はシステムボイスを再生しない
	}

	// サウンドタブ内キャラ個別ボイス設定
	if (section("06sound") || section("voice")) {
		setVoiceAll(true, 100);						// 全キャラボイスON

		var vol = kag.setVoiceVolume;
		//vol("キャラ名",   100);
	}

	// ダイアログ設定タブ
	if (section("07dialog")) {
		// 確認ダイアログの設定の初期化
		ForeachConfirmDialogTags(function (tag, defval) {
			SystemConfig[tag] = defval;
		} incontextof global);
	}

	// マウス設定タブ
	if (section("08mouse")) {
		var bind = kag.scflags.mouseGesture = %[];
		(Dictionary.assign incontextof bind)(SystemConfig.mouseGestureDefaults);
		try { kag.mouseGesture.enabled = -1; } catch {}
	}

	// ゲームパッド設定タブ（※処理の順序の都合上，ショートカットキーの初期化より前に配置すること）
	if (section("10gamepad")) {
		GamePadRebind.clear(!(isFirst || tag == ""));

		if (!isFirst) with (SystemConfig) {
			// ゲームパッド操作無効を解除
			GamePadEnabled.change(true) if (!.GamePadExForceDisabled && !.GamePadExEnabled);
		}
	}
	// ショートカットキー設定タブ
	if (section("09keyboard")) {
		resetAllShortcutKeys(isFirst);
	}

	// 初回起動時(savedataがない)のみの初期化処理
	if (isFirst) {
		sf.saveOverwrite = true;				// セーブ上書き確認

		// DSoundセカンダリバッファを常に再生成
		setDefaultSystemArgument("wsrecreate", "yes");
		@if (kirikiriz) try { WaveSoundBuffer.freeDirectSound(); } catch {} @endif // [XXX] DirectSound作り直し(kzではwsrecreateが反映される）

		// パッドリピート間隔
		setDefaultSystemArgument("padinterval", 70);

		// フレーム上限を設定
		setDefaultSystemArgument("contfreq", 60);

		// VistaではダブルバッファをDirect3Dに
		setDefaultSystemArgument("dbstyle", "d3d") if (checkWindowsVersion("vista"));

		// 等倍でもダブルバッファ有効
		setDefaultSystemArgument("usedb", "yes");
	}

	// 表情窓同期表示
	//kag.scflags.faceMode = true;
}

