	.MovieAudioSampleFile = function {
		var file = SystemConfig.DefaultTitleBGM;
		if (tf.allseen || sf.movie_op) file = "SongOP"; // OPムービーを見る前後でボーカル有無を決定
		return file + "*sabi";
	} incontextof global;
