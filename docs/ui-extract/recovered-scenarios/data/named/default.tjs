KAGLoadScript("yuzu_default.tjs"); // 作品固有の定義がないdefault

// タイトル背景選択
function GetTitleImageFile(mode/*0:raw, 1:img, -1:num*/, idx = GetTitleImageFile.GetNum()) {
	var stat = GetTitleImageFile.Status();
	var num = +idx;
	if (num < 0 || num >= (stat.count\2) || (!tf.allseen && !stat[num*2+1])) num = 0; // 補正
	if (mode < 0) return num;
	var file = stat[num*2];
	return mode ? getExistImageName(file) : file;
	function Change(idx) {     sf.TitleBGIndex = idx; }
	function GetNum() { return sf.TitleBGIndex; }
	function IsLeft() { //return true; }
		switch (GetTitleImageFile(-1)) {
		case 2: case 5: case 7: return true; // title_bg{2,5,7} is left lang menu
		}
		return false;
	}
	function Status() {
		// タイトル背景解放条件
		var after = GetClearFlag("after_");
		return [
			"title_bg0" => true,   // 通常
			"title_bg1" => after.any,   // 異世界
			"title_bg2" => sf.clear_noa,   // のあ
			"title_bg3" => sf.clear_ama,   // あまね
			"title_bg4" => sf.clear_kur,   // くるみ
			"title_bg5" => sf.clear_kag,   // かぐや
			"title_bg6" => sf.clear_ori,   // おりえ
			"title_bg7" => sf.clear_fum,   // ふみか
			"title_bg8" => after.all ];    // 全員
	}
	function UseMotion() {
		if (!enableSceneAnimEffect) return false;
		var img = world_object.getImageData(GetTitleImageFile(false));
		//dm("UseMotion", getPrint(img));
		return img && Storages.isExistentStorage(img.storage);
	}
}

