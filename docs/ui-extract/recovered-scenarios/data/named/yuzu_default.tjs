// [メガネ選択]マクロ翻訳
///function _megane_select(onoff, defval, key = "SceneModeMeganeSelect") {...}

// 環境初期化処理
///function initialEnvironment(isFirst = false, tag) {...}


function propDrawTextParamMapTable() {
	function _{
		property delayload { getter {
			var ret, file = "ctxfontprefs";
			if (debugWindowEnabled && typeof global.developMode != "undefined" && developMode) {
				//dm(file, Scripts.getTraceString());
				Plugins.link("toml.dll") if (typeof Scripts.tomlDecodeFromStorage == "undefined");
				try {
					ret = Scripts.tomlDecodeFromStorage(file+".toml");
				} catch(e) {
					System.inform(file+".toml: load failed.");
				}
				if (ret) with (Storages) (Dictionary.saveStruct incontextof ret)(.chopStorageExt(.getPlacedPath(file+".toml"))+".tjs", "b");
			}
			if (!ret) try {
				ret = Scripts.evalStorage(file+".tjs");
			} catch (e) {
				System.inform(e.message);
				ret = %[];
			}
			return &SystemConfig.drawTextParamMapTable = ret;
		}  }
	}
	return &_.delayload incontextof global;
}
