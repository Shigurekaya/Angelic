function MakeSystemLangMessageProxy(tags, obj = SystemConfig) {
	function _ { property proxy {
		getter { return GetSystemLangMessage(this[0], this[1]); }
		setter(v) { this[1] = v; }
	} }
	const prop = &_.proxy;
	for (var i = tags.count; --i >= 0;) {
		var tag = tags[i];
		if (tag != "") &obj[tag] = prop incontextof [ tag, obj[tag] ];
	}
}
function GetScnConvertLangList() {
@if (CUSTOM_MULTILANG)
	var r = [];
	r.assign(SystemConfig.multiLangLanguageTags);
	r.shift();
	return r.join(",");
@endif
	return "";
}

function GetRouteName(scn) {
	var map = SystemConfig.routeScenarioPrefixMap, route, src = (string)scn;
	if (map && src != "") {
@if (CUSTOM_USE_R18HACK) 
		if (src.substr(0,2) == "x_") src = src.substr(2); // ルートアイコン判定修正
@endif
		for (var i = 0, tag = "*"; (tag != "" && i < 10); i++) {
			var get = map[tag.toLowerCase()];
			switch (typeof get) {
			case "String": case "void":
				route = get;
				tag = void;
				break;
			case "Integer":
				tag = src.substr(0, get);
				break;
			case "Object":
				tag = get(scn, map);
				break;
			}
		}
	}
	return route;
}

function GetClearFlag(prefix = "clear_", list = SystemConfig.clearFlagTagList) {
	var r = %[];
	var all = true, any = false;
	if (list.count == 0) all = any = !!sf.clear; // [XXX]
	else for (var i = 0, cnt = list.count; i < cnt; i++) {
		var key = list[i];
		if (key == "") continue;
		var value = !!sf[prefix + key];
		all &&= value;
		any ||= value;
		r[key] = value;
	}
	r.all = all;
	r.any = any;
	return r;
}
