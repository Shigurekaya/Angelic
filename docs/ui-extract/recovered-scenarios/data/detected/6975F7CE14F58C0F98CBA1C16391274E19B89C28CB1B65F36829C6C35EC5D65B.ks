# 画面割り当て

#-------------------------------
# タイトル画面
[screen.title]

bg0			= { style="bgsel", default="1", text="title_bgsel_1" }
bg1			= { style="bgsel", default="2", text="title_bgsel_2" }
bg2			= { style="bgsel", default="3", text="title_bgsel_3" }
bg3			= { style="bgsel", default="4", text="title_bgsel_4" }
bg4			= { style="bgsel", default="5", text="title_bgsel_5" }
bg5			= { style="bgsel", default="6", text="title_bgsel_6" }
bg6			= { style="bgsel", default="7", text="title_bgsel_7" }
bg7			= { style="bgsel", default="8", text="title_bgsel_8" }
bg8			= { style="bgsel", default="9", text="title_bgsel_9" }

#-------------------------------
# ダイアログ画面
[screen.dialog]

yes			= { style="btn",  text="dialog_btn_yes" }
no			= { style="btn",  text="dialog_btn_no"  }
chk			= { style="wchk", text="dialog_btn_check" }
suspend_on		= { style="wrad", text="common_on" }
suspend_off		= { style="wrad", text="common_off" }

text.style		= "dlgtext"	# cf. [screen.dialog.text.states]
suspend.style		= "dlgsus"	# cf. [screen.dialog.suspend.states]

# メッセージ群
[screen.dialog.text.states]
	asktitle	= "dialog_mes_title"		# タイトルに戻る
	askexit		= "dialog_mes_exit"		# ゲーム終了
	askinit		= "dialog_mes_init"		# 設定初期化
	askinitall	= "dialog_mes_initall"		# 全ての設定を初期化 (※ShiftKeyボタン押下時)
	askload		= "dialog_mes_load"		# ロード
	asksave		= "dialog_mes_save"		# セーブ
	askdsave	= "dialog_mes_dsave"		# ダイレクトセーブ
	askoverwrite	= "dialog_mes_overwrite"	# 上書き
	askqsave	= "dialog_mes_qsave"		# クイックセーブ
	askqload	= "dialog_mes_qload"		# クイックロード
	askbackto	= "dialog_mes_prevsel"		# 前の選択肢
	asknext		= "dialog_mes_nextsel"		# 次の選択肢
	askprevscn	= "dialog_mes_prevscn"		# 前のシーン
	asknextscn	= "dialog_mes_nextscn"		# 次のシーン
	askjump		= "dialog_mes_jump"		# バックログジャンプ
	askflow		= "dialog_mes_jump"		# フローチャートジャンプ
	askquitreplay	= "dialog_mes_quit"		# 回想を中断
	askcopy		= "dialog_mes_copy"		# コピー
#	askmove		= "dialog_mes_move"		# 移動
	askswap		= "dialog_mes_swap"		# 交換
	askdelete	= "dialog_mes_delete"		# 削除
	askinitstand	= "dialog_mes_standinit"	# 立ち絵鑑賞初期化
	askvsave	= "dialog_mes_vsave"		# ボイス保存
	askresume	= "dialog_mes_resume"		# 復帰
#	askreadjump	= "dialog_mes_readjump"		# 既読自動ジャンプ

